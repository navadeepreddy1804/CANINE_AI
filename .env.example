# ==============================================================================
# CanineAI Enterprise Healthcare Platform - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and populate actual credentials before launching services.
# NEVER commit the active '.env' file containing real secrets to source control.

# --- Spring Boot Backend Configuration ---
SPRING_PROFILES_ACTIVE=dev
AI_MODE=real
JWT_SECRET=AxfqrVgQLUUq76dOith7gXn+NbBlAs+s5sLdwnqXxXL4i6KmmywSFdQAxB+LTT8jn7Z0SjMSuJ+17Dxu7/5Rwg==
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=CanineAI

# Secure Gateway Authorization Token
INTERNAL_GATEWAY_KEY=2f9f8c6e268fa1d293c6ae1849a629b35b64c781fe590f23d132a890a599b821

# --- MySQL Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=canineai_dev
DB_USER=root
DB_PASS=your_mysql_password

# --- generative LLM Report Engine (Gemini Only) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=nano-banana

# --- SMTP Mail Service Configuration ---
# Leave MAIL_PASSWORD empty to disable email (app starts normally, falls back to console logging)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
# TODO: Enter your Gmail App Password below (NOT the account password)
MAIL_PASSWORD=
MAIL_FROM=CanineAI <your_email@gmail.com>
MAIL_TLS=true
MAIL_SMTP_AUTH=true

# --- Session & Security Parameter Controls ---
SESSION_TIMEOUT_MINUTES=60
REMEMBER_ME_DAYS=30
PASSWORD_MIN_LENGTH=8
PASSWORD_BCRYPT_ROUNDS=12

# --- Storage & Sizing Parameters ---
MAX_UPLOAD_SIZE_MB=2048
MAX_REQUEST_SIZE_MB=2048
REPORT_DIR=reports
UPLOAD_DIR=uploads
MODEL_DIR=trained-models
LOG_LEVEL=INFO
