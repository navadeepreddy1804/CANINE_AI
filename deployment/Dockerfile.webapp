# Multi-stage build for Spring Boot Web App Client
FROM maven:3.9.8-eclipse-temurin-21 AS build
WORKDIR /workspace

# Copy Maven POMs
COPY pom.xml .
COPY shared-api/pom.xml shared-api/
COPY web-app/pom.xml web-app/

# Fetch Maven dependencies (caching layer)
RUN mvn dependency:go-offline -B -pl web-app,shared-api -am

# Copy source structures
COPY shared-api/src shared-api/src
COPY web-app/src web-app/src

# Compile and package jar package
RUN mvn clean package -DskipTests -B -pl web-app,shared-api -am

# Lightweight execution stage
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

RUN groupadd -g 10003 webuser && \
    useradd -u 10003 -g webuser -s /bin/sh -m webuser

# Copy built artifacts from compiler stage
COPY --from=build --chown=webuser:webuser /workspace/web-app/target/web-app-1.0.0-SNAPSHOT.jar app.jar

USER webuser
EXPOSE 8081
ENV SPRING_PROFILES_ACTIVE=prod

ENTRYPOINT ["java", "-jar", "app.jar"]
