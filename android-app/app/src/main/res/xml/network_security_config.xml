<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network security config (used by release builds).
  Cleartext HTTP is blocked everywhere except the explicit local-dev domains below.
  The debug source set overrides this file entirely for debug builds.
-->
<network-security-config>

    <!-- Block cleartext on all hosts by default (production safe) -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Production API — HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.canineai.example.com</domain>
    </domain-config>

    <!--
      Local developer hosts — cleartext HTTP allowed.
      Covers: Android emulator (10.0.2.2), loopback, and the two most common
      LAN private ranges used by home/office routers (192.168.x.x, 10.x.x.x).
      These entries have no effect in release builds because the debug source
      set supplies its own network_security_config.xml that overrides this file.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Android emulator → host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- LAN: 192.168.0.0/16 — home/office routers -->
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.100</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
        <domain includeSubdomains="true">192.168.0.101</domain>
        <domain includeSubdomains="true">192.168.1.101</domain>
        <domain includeSubdomains="true">192.168.0.102</domain>
        <domain includeSubdomains="true">192.168.1.102</domain>
        <!-- LAN: 10.0.x.x — corporate / hotspot ranges -->
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.2</domain>
        <domain includeSubdomains="true">10.0.1.1</domain>
    </domain-config>

</network-security-config>
